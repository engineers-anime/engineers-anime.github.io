---
import CallToAction from './CallToAction.astro'
import Logo from './Logo.astro'
import { Heading, Link } from 'accessible-astro-components'
import { getTranslations } from '../i18n'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
const t = getTranslations(Astro.url.pathname)
const isEnglish = Astro.url.pathname.startsWith('/en')
const eventGuidelinesHref = isEnglish ? '/en/guidelines/events/' : '/guidelines/events/'
const discordGuidelinesHref = isEnglish ? '/en/guidelines/discord/' : '/guidelines/discord/'
const contactHref = isEnglish ? '/en/contact/' : '/contact/'
---

<footer>
  <CallToAction title={t.footer.ctaTitle} linkText={t.footer.followX} secondaryLinkText={t.footer.joinDiscord} />
  <section class="py-20">
    <Heading level="h2" class="sr-only">Footer</Heading>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <Logo loading="lazy" isLink={false} />
        <p class="leading-[1.75]">
          {t.footer.description}<br />
          {t.footer.organizer}: <Link isExternal href="https://x.com/uutan1108">うーたん</Link>
        </p>
        <Link href={contactHref} class="inline-flex items-center gap-2 self-start">
          {t.footer.contact}
        </Link>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">{t.footer.community}</Heading>
        <ul class="flex flex-col gap-2">
          <li>
            <Link isExternal href="https://engineers-anime.connpass.com/">connpass</Link>
          </li>
          <li>
            <Link isExternal href="https://twitter.com/engineers_anime">X (Twitter)</Link>
          </li>
          <li>
            <Link isExternal href="https://note.com/engineers_anime/magazines">note</Link>
          </li>
          <li>
            <Link isExternal href="https://discord.gg/dgPWe6rNWS">Discord</Link>
          </li>
          <li>
            <Link isExternal href="https://github.com/engineers-anime">GitHub</Link>
          </li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">{t.footer.guidelinesHeading}</Heading>
        <ul class="flex flex-col gap-2">
          <li>
            <Link href={eventGuidelinesHref}>{t.footer.eventGuidelines}</Link>
          </li>
          <li>
            <Link href={discordGuidelinesHref}>{t.footer.discordRules}</Link>
          </li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Heading level="h3" size="h6">{t.footer.illustration}</Heading>
        <ul class="flex flex-col gap-2">
          <li>
            <Link isExternal href="https://x.com/DDDD__akagi">赤城ナツイチ</Link>
          </li>
        </ul>
        <Heading level="h3" size="h6">{t.footer.logo}</Heading>
        <ul class="flex flex-col gap-2">
          <li>
            <Link isExternal href="https://x.com/mottox2">もっと</Link>
          </li>
        </ul>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} - {t.siteName}.
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>

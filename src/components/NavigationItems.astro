---
import themeConfig from '@theme-config'
import { Link, DarkMode } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

const isEnglish = Astro.url.pathname.startsWith('/en')
const getNavigationLabel = (label: string) => (isEnglish && label === 'Xをフォロー' ? 'Follow on X' : label)

/**
 * Navigation Items Component
 *
 * @description A component that displays the navigation items for the website
 */
---

<ul class="menu">
  {
    themeConfig.navigation.items.map((item) => (
      <li class={`menu-item ${item.type === 'dropdown' ? 'has-dropdown' : ''} ${item.icon ? 'type-icon' : ''}`}>
        {item.type === 'dropdown' ? (
          <button aria-haspopup="true" aria-expanded="false">
            {getNavigationLabel(item.label)}
            <Icon aria-hidden="true" name="lucide:chevron-down" size="32" />
          </button>
        ) : !item.type || item.type === 'link' ? (
          <Link href={item.href} isExternal={item.external ?? false} hideIcon={!!item.icon}>
            {item.icon ? (
              <span class="icon-link-content">
                <Icon aria-hidden="true" name={item.icon} size="32" />
                <span class="icon-label">{getNavigationLabel(item.label)}</span>
              </span>
            ) : (
              getNavigationLabel(item.label)
            )}
          </Link>
        ) : null}
        {item.type === 'dropdown' && (
          <ul class="dropdown-menu">
            {item.items.map((subItem) => (
              <li class="submenu-item">
                <Link href={subItem.href} isExternal={subItem.external ?? false}>
                  {subItem.label}
                </Link>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
  {
    themeConfig.navigation.darkmode && (
      <li class="menu-item type-icon theme-toggle">
        <div class="icon-link-content">
          <DarkMode />
          <span class="icon-label">{isEnglish ? 'Theme' : 'テーマ'}</span>
        </div>
      </li>
    )
  }
  <li class="menu-item type-icon bg-animation-toggle">
    <div class="icon-link-content">
      <button
        aria-label={isEnglish ? 'Toggle background animation' : '背景アニメーションの切り替え'}
        class="bg-animation-toggle-btn"
      >
        <div class="icon-cloud-on">
          <Icon aria-hidden="true" name="lucide:cloud-off" size="32" />
        </div>
        <div class="icon-cloud-off">
          <Icon aria-hidden="true" name="lucide:cloud" size="32" />
        </div>
      </button>
      <span class="icon-label">{isEnglish ? 'Clouds' : '背景雲'}</span>
    </div>
  </li>
  <li class="menu-item type-icon language-switcher">
    <Link href={isEnglish ? '/' : '/en/'} hideIcon>
      <span class="icon-link-content">
        <Icon aria-hidden="true" name="lucide:languages" size="32" />
        <span class="icon-label">{isEnglish ? '日本語' : 'English'}</span>
      </span>
    </Link>
  </li>
</ul>

<style lang="scss" is:global>
  @use '../assets/scss/base/mixins' as *;
  @use '../assets/scss/base/breakpoint' as *;

  .icon-link-content {
    display: flex !important;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    text-align: left;
  }

  .icon-label {
    font-weight: 500;
    font-size: 0.875rem;
    white-space: nowrap;

    @include breakpoint('nav') {
      display: none;
    }
  }

  // Tooltip for desktop
  .type-icon {
    position: relative;

    &:hover .icon-label {
      @include breakpoint('nav') {
        display: block;
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1001;
        margin-top: 0.5rem;
        box-shadow: var(--elevation-2);
        border-radius: 4px;
        background-color: var(--color-neutral-800);
        padding: 0.2rem 0.6rem;
        pointer-events: none;
        color: var(--color-neutral-100);
        font-size: 0.75rem;
        line-height: 1.2;

        &::before {
          position: absolute;
          bottom: 100%;
          left: 50%;
          transform: translateX(-50%);
          border: 5px solid transparent;
          border-bottom-color: var(--color-neutral-800);
          content: '';
        }
      }
    }
  }

  // Specifically for theme toggle and bg animation toggle
  .theme-toggle,
  .bg-animation-toggle {
    cursor: pointer;

    .icon-link-content {
      height: 100%;
    }

    button,
    .darkmode-toggle {
      display: flex !important;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      border: none !important;
      background: none !important;
      padding: 0 !important;
      color: var(--foreground-color) !important;

      &:hover {
        background: none !important;
      }

      :global(svg) {
        margin: 0 !important;
        inline-size: 32px !important;
        block-size: 32px !important;
      }
    }
  }

  .bg-animation-toggle-btn {
    .icon-cloud-on {
      display: flex;
    }
    .icon-cloud-off {
      display: none;
    }

    body[data-hide-clouds='true'] & {
      .icon-cloud-on {
        display: none;
      }
      .icon-cloud-off {
        display: flex;
      }
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Theme toggle click handler for the whole area
    const themeToggles = document.querySelectorAll('.theme-toggle')
    themeToggles.forEach((toggle) => {
      toggle.addEventListener('click', (event) => {
        const button = toggle.querySelector('.darkmode-toggle') as HTMLButtonElement | null
        const target = event.target as HTMLElement

        if (button && target !== button && !button.contains(target)) {
          button.click()
        }
      })
    })

    // BG Animation toggle click handler for the whole area
    const bgToggles = document.querySelectorAll('.bg-animation-toggle')
    bgToggles.forEach((toggle) => {
      toggle.addEventListener('click', (event) => {
        const button = toggle.querySelector('.bg-animation-toggle-btn') as HTMLButtonElement | null
        const target = event.target as HTMLElement

        if (button && target !== button && !button.contains(target)) {
          button.click()
        }
      })
    })
  })
</script>

---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import Counter from '@components/Counter.astro'
import ContentMedia from '@components/ContentMedia.astro'
import Slideshow from '@components/Slideshow.astro'
import FeaturedPosts from '@components/FeaturedPosts.astro'
import RecentNotes from '@components/RecentNotes.astro'
import RecentPosfie from '@components/RecentPosfie.astro'
import FeaturedBooks from '@components/FeaturedBooks.astro'
import CharacterGoods from '@components/CharacterGoods.astro'
import { Accordion, AccordionItem, Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { parse } from 'node-html-parser'
import { books } from '../data/booth-books'
import eventLogo from '../assets/img/logo-minified.svg'
import { getTranslations } from '../i18n'

// Calculate activity months since 2024/05/07
const startDate = new Date('2024-05-07')
const today = new Date()
const monthsDiff = (today.getFullYear() - startDate.getFullYear()) * 12 + (today.getMonth() - startDate.getMonth())
const activityMonths = `${monthsDiff}+`

// Scrape connpass data at build time
let memberCount = '600+' // Default value if scraping fails
let eventCount = '30+' // Default value if scraping fails
try {
  const response = await fetch('https://engineers-anime.connpass.com/', {
    headers: { 'User-Agent': 'Mozilla/5.0' },
  })
  const html = await response.text()
  const root = parse(html)

  // Extract member count more robustly
  const sideArea = root.querySelector('#side_area')
  if (sideArea) {
    const memberAmount = sideArea.querySelector('.amount')
    if (memberAmount) {
      memberCount = memberAmount.text.trim()
    }
  }

  // Extract event count
  const eventLink = root.querySelectorAll('a').find((a) => a.text.includes('全てのイベントを見る'))
  if (eventLink) {
    const match = eventLink.text.match(/（(\d+)件）/)
    if (match) {
      eventCount = match[1]
    }
  }
} catch (error) {
  console.error('Error scraping connpass:', error)
}

const bookCount = books.length.toString()
const copy = getTranslations(Astro.url.pathname).home
---

<DefaultLayout title={copy.pageTitle} useTitleTemplate={false}>
  <Hero />
  <section id="activities" class="my-64">
    <div class="container">
      <Heading level="h2" class="mb-6">{copy.activities}</Heading>
      <p class="mb-8 text-xl">{copy.activitiesIntro}</p>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
        <Feature icon="lucide:users" title={copy.community}>{copy.communityText}</Feature>
        <Feature imgSrc={eventLogo.src} title={copy.events}>{copy.eventsText}</Feature>
        <Feature icon="lucide:book-open" title={copy.bookCreation}>{copy.bookCreationText}</Feature>
      </div>
    </div>
  </section>
  <ContentMedia sectionId="meetups">
    <Slideshow slot="media" folder="slides/study" maxWidth="600px" hasBorder={true} />
    <div class="mb-4 flex items-center gap-4">
      <img src={eventLogo.src} alt="" aria-hidden="true" class="h-12 w-auto" />
      <Heading level="h2">{copy.events}</Heading>
    </div>
    <p class="text-2xl">
      {copy.eventsDetail}
    </p>
  </ContentMedia>
  <ContentMedia sectionId="book-creation" reverseImg={true}>
    <Slideshow slot="media" folder="slides/book" aspectRatio="722/1024" maxWidth="400px" hasBorder={true} />
    <Heading level="h2">{copy.bookCreation}</Heading>
    <p class="text-2xl">{copy.booksDetail}</p>
  </ContentMedia>
  <FeaturedPosts />
  <RecentNotes title={copy.officialNotes} description={copy.officialNotesDescription} />
  <RecentNotes
    sectionId="community-note-posts"
    title={copy.communityBlogs}
    description={copy.communityBlogsDescription}
    feedUrls={['https://note.com/hashtag/エンジニアニメ/rss']}
    moreHref="https://note.com/hashtag/エンジニアニメ"
    moreLabel={copy.moreCommunityNotes}
    emptyMessage={copy.noCommunityNotes}
  />
  <RecentPosfie />
  <FeaturedBooks />
  <CharacterGoods />
  <section id="faq" class="my-64">
    <div class="container grid grid-cols-1 gap-12 md:grid-cols-2">
      <div class="flex flex-col items-start gap-4">
        <Heading level="h2">{copy.faq}</Heading>
        <p class="text-2xl">{copy.faqIntro}</p>
        <div class="flex flex-wrap gap-4">
          <Link
            href="https://twitter.com/intent/follow?screen_name=engineers_anime"
            isButton
            isExternal
            type="primary"
            animateOnHover
            animationType="boop"
          >
            <Icon aria-hidden="true" name="simple-icons:x" size=" 1.5rem" />
            {copy.followX}
          </Link>
          <div class="discord-button-wrapper">
            <Link
              href="https://discord.gg/dgPWe6rNWS"
              isButton
              isExternal
              type="secondary"
              animateOnHover
              animationType="boop"
            >
              <Icon aria-hidden="true" name="simple-icons:discord" size=" 1.5rem" />
              {copy.joinDiscord}
            </Link>
          </div>
        </div>
      </div>
      <div class="space-content">
        <Accordion>
          <AccordionItem name="exclusive" title={copy.faqBeginner} open>
            <p>{copy.faqBeginnerAnswer}</p>
          </AccordionItem>
          <AccordionItem name="exclusive" title={copy.faqLocation}>
            <p>{copy.faqLocationAnswer}</p>
          </AccordionItem>
          <AccordionItem name="exclusive" title={copy.faqStack}>
            <p>{copy.faqStackAnswer}</p>
          </AccordionItem>
          <AccordionItem name="exclusive" title={copy.faqCost}>
            <p>{copy.faqCostAnswer}</p>
          </AccordionItem>
        </Accordion>
      </div>
    </div>
  </section>
  <section id="numbers" class="mt-64 mb-32">
    <div class="container">
      <Heading level="h2" class="mb-6">{copy.numbers}</Heading>
      <p class="mb-16 text-xl">{copy.numbersIntro}</p>
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 md:grid-cols-4">
        <Counter count={memberCount} title="Members" sub={copy.members} />
        <Counter count={eventCount} title="Events" sub={copy.eventCount} />
        <Counter count={bookCount} title="Books" sub={copy.books} />
        <Counter count={activityMonths} title="Months" sub={copy.months} />
      </div>
    </div>
  </section>
</DefaultLayout>

<script>
  const addSectionLinks = () => {
    const isEnglish = document.documentElement.lang.startsWith('en')
    const linkLabel = isEnglish ? 'Link to this section' : 'このセクションへのリンク'

    document.querySelectorAll<HTMLElement>('section[id]').forEach((section) => {
      const heading = section.querySelector<HTMLHeadingElement>('h2')
      if (!heading || heading.querySelector('.section-link')) return

      const link = document.createElement('a')
      link.href = `#${section.id}`
      link.className = 'section-link'
      link.setAttribute('aria-label', `${heading.textContent?.trim()}: ${linkLabel}`)
      link.title = linkLabel
      link.textContent = '#'
      heading.append(link)
    })
  }

  const scrollToCurrentSection = () => {
    if (!window.location.hash) return

    const sectionId = decodeURIComponent(window.location.hash.slice(1))
    const section = document.getElementById(sectionId)
    if (!section) return

    requestAnimationFrame(() => {
      requestAnimationFrame(() => section.scrollIntoView())
    })
  }

  const initializeSectionLinks = () => {
    addSectionLinks()
    scrollToCurrentSection()
  }

  document.addEventListener('astro:page-load', initializeSectionLinks)
  window.addEventListener('load', scrollToCurrentSection)
  initializeSectionLinks()
</script>

<style>
  :global(section[id]) {
    scroll-margin-top: 7rem;
  }

  :global(.section-link) {
    display: inline-block;
    vertical-align: 0.12em;
    transform: translateX(-0.1em);
    opacity: 0;
    transition:
      opacity 150ms ease,
      transform 150ms ease;
    margin-inline-start: 0.15em;
    pointer-events: none;
    color: var(--color-primary-500);
    font-size: 0.65em;
    text-decoration: none;
  }

  :global(h2:hover .section-link),
  :global(h2:focus-within .section-link),
  :global(.section-link:focus-visible) {
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
    text-decoration: none;
  }

  @media (hover: none) {
    :global(.section-link) {
      transform: translateX(0);
      opacity: 0.45;
      pointer-events: auto;
    }
  }

  .discord-button-wrapper {
    :global(.button.secondary) {
      border-color: #5865f2 !important;
      background-color: #5865f2 !important;
      color: white !important;

      &:hover,
      &:focus-visible {
        border-color: color-mix(in srgb, #5865f2, black 10%) !important;
        background-color: color-mix(in srgb, #5865f2, black 10%) !important;
      }
    }
  }
</style>

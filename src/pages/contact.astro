---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import { contactCopy } from '../data/contact'
import { getLocale } from '../i18n'

const locale = getLocale(Astro.url.pathname)
const copy = contactCopy[locale]
const homeHref = locale === 'en' ? '/en/' : '/'
---

<DefaultLayout title={copy.title} description={copy.description}>
  <div class="container my-32 max-w-5xl">
    <nav aria-label={locale === 'en' ? 'Breadcrumb' : 'パンくずリスト'} class="mb-8">
      <ol class="flex flex-wrap items-center gap-2 text-sm">
        <li><Link href={homeHref}>{copy.home}</Link></li>
        <li aria-hidden="true"><Icon name="lucide:chevron-right" size="1rem" /></li>
        <li aria-current="page">{copy.title}</li>
      </ol>
    </nav>

    <Heading level="h1" size="h2" class="mb-6">{copy.title}</Heading>
    <p class="mb-4 text-xl leading-relaxed">{copy.description}</p>
    <p class="mb-12 leading-relaxed">{copy.intro}</p>

    <div class="mb-16 grid gap-5 md:grid-cols-3">
      {
        copy.topics.map((topic) => (
          <article class="contact-topic rounded-2xl p-6">
            <Icon aria-hidden="true" name={topic.icon} size="2rem" />
            <Heading level="h2" size="h5" class="mt-4 mb-2">
              {topic.title}
            </Heading>
            <p class="leading-relaxed">{topic.description}</p>
          </article>
        ))
      }
    </div>

    <section class="email-panel rounded-3xl p-8 md:p-12">
      <Heading level="h2" size="h4" class="mb-3">{copy.emailTitle}</Heading>
      <p class="mb-6 leading-relaxed">{copy.emailDescription}</p>
      <button
        id="compose-email"
        class="email-button inline-flex items-center gap-2 rounded-full px-6 py-3 font-bold"
        type="button"
        data-subject={copy.subject}
      >
        <Icon aria-hidden="true" name="lucide:mail" size="1.4rem" />
        {copy.button}
      </button>
      <p class="mt-5 text-sm">
        {copy.addressLabel}: <span id="contact-address">engineers.anime [at] gmail.com</span>
      </p>
      <p class="mt-6 text-sm opacity-80">{copy.note}</p>
    </section>
  </div>
</DefaultLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const composeButton = document.querySelector<HTMLButtonElement>('#compose-email')

    composeButton?.addEventListener('click', () => {
      const local = ['engineers', 'anime'].join('.')
      const domain = ['gmail', 'com'].join('.')
      const subject = composeButton.dataset.subject ?? ''
      window.location.href = `mailto:${local}@${domain}?subject=${encodeURIComponent(subject)}`
    })
  })
</script>

<style>
  .contact-topic {
    border: 1px solid var(--border-color-subtle);
    background: color-mix(in srgb, var(--background-color) 92%, var(--brand-primary));
  }

  .email-panel {
    background: color-mix(in srgb, var(--brand-primary) 12%, var(--background-color));
  }

  .email-button {
    transition:
      translate 150ms ease,
      filter 150ms ease;
    cursor: pointer;
    border: 2px solid var(--brand-primary);
    background: var(--brand-primary);
    color: var(--color-neutral-900);
  }

  .email-button:hover,
  .email-button:focus-visible {
    translate: 0 -2px;
    filter: brightness(0.92);
  }
</style>
